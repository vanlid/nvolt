# Pinned upstream versions for the wolfSSL / wolfTPM / wolfPKCS11 build
# (bump deliberately; these are the tested set).
#
# Sourced by build/pkcs11/build-module.sh. Kept as a standalone file so a
# version bump is a one-line change here instead of an edit to the script,
# and so .github/workflows/track-releases.yml can detect + PR bumps
# automatically.
WOLFSSL_TAG=v5.9.2-stable
WOLFTPM_TAG=v4.1.0
WOLFPKCS11_TAG=v2.1.0-stable

# FORK_BUILD (N) is the fork's build number on the CURRENT upstream base, used by
# the release version scheme v<upstream X.Y.Z>.<N>-<channel> (see
# .github/workflows/release.yml). Bump it for each release-worthy fork change
# (the wolf-track job bumps it automatically when it bumps a wolf pin above);
# reset to 1 when rebasing onto a new upstream X.Y.Z.
FORK_BUILD=1
